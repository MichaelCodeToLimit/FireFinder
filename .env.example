# =============================================================================
# FireFinder configuration. Copy to .env and fill in what you need.
# .env is gitignored: never commit it, and never paste real values here.
#
# Local development needs NONE of this: with no .env at all, `npm run dev`
# uses an on-disk PGlite database in .data/ and creates a local dev API key.
#
# FireFinder never needs Supabase's anon/publishable or service-role keys:
# it connects to Postgres directly and authenticates callers itself.
# =============================================================================

# --- Node API server (self-hosting) ------------------------------------------
# PostgreSQL with pgvector. For Supabase use the Session pooler (port 5432) or
# the Transaction pooler (port 6543; prepared statements are then disabled
# automatically). Default: pglite://.data/firefinder (zero-setup local dev).
DATABASE_URL=
DB_POOL_MAX=10
# auto | true | false
DB_PREPARE=auto
# Apply migrations on startup. Empty = true for pglite, false for postgres.
AUTO_MIGRATE=
# Secret used to derive anonymous voter hashes (one vote per install).
# Required for a shared database; generated automatically for local PGlite.
# Generate with: openssl rand -hex 32
FIREFINDER_VOTER_SECRET=
# Browser origins allowed to call the API (comma-separated). Empty = none.
CORS_ORIGINS=
# Trust X-Forwarded-For for per-IP rate limits (only behind your own proxy).
TRUST_PROXY=false
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=20
PORT=8787
HOST=127.0.0.1
# Serve the developer console at /
DEV_CONSOLE=true
# Embeddings run locally (gte-small, no external AI calls). The model (~34 MB)
# downloads once to EMBEDDING_CACHE_DIR. q8 | fp16 | fp32
EMBEDDING_DTYPE=q8
EMBEDDING_CACHE_DIR=.cache/models

# --- Remote MCP endpoint on the Node server ----------------------------------
# Public base URL of this server: the OAuth issuer; the MCP endpoint is <url>/mcp.
# Default: http://localhost:$PORT. Must be the https:// URL users reach in production.
FIREFINDER_PUBLIC_URL=
# Signs OAuth access tokens and client ids. Default: FIREFINDER_VOTER_SECRET.
FIREFINDER_OAUTH_SECRET=
MCP_READ_PER_MINUTE=60
MCP_WRITE_PER_MINUTE=20
MCP_IDENTITIES_PER_IP_PER_HOUR=10

# --- Supabase Edge Function ---------------------------------------------------
# Not read from this file: set these as function secrets instead, e.g.
#   supabase secrets set FIREFINDER_VOTER_SECRET=<random-hex> FIREFINDER_DB_REGION=<region>
# Required: FIREFINDER_VOTER_SECRET. Optional: FIREFINDER_DB_REGION (database
# region; database-bound requests are forwarded there), FIREFINDER_OAUTH_SECRET,
# FIREFINDER_PUBLIC_URL, CORS_ORIGINS, RATE_LIMIT_*, MCP_*.
# SUPABASE_URL, SUPABASE_DB_URL and SB_REGION are provided by the platform.

# --- Scripts and the local stdio MCP server ----------------------------------
# REST API used by `npm run smoke`, `npm run demo` and the stdio MCP server.
FIREFINDER_API_URL=http://localhost:8787
# Hosted on Supabase: the database region (e.g. eu-central-1), so the API runs
# next to the database. Leave empty for local/Node servers.
FIREFINDER_API_REGION=
# API key with read,write scopes (`npm run keys:create`). Local dev: .data/dev-api-key.
FIREFINDER_API_KEY=
# Admin key. Lets `npm run smoke -- --write` and `npm run smoke:mcp` disable
# their test record; both refuse to write to a deployed server without it.
FIREFINDER_ADMIN_KEY=
# Remote MCP endpoint checked by `npm run smoke:mcp`. Default: $FIREFINDER_API_URL/mcp
# FIREFINDER_MCP_URL=
# Anonymous install id for the stdio MCP server. Default: ~/.firefinder/client-id
# FIREFINDER_CLIENT_ID=
