# =============================================================================
# FireFinder configuration. Copy to .env and fill in. Never commit .env.
# Everything is optional for local development: with no .env at all,
# `npm run dev` uses an on-disk PGlite database and creates a dev API key.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Used to build the hosted API URL: $SUPABASE_URL/functions/v1/firefinder
SUPABASE_URL=
# Publishable/anon key. Not needed by FireFinder itself (it uses its own API
# keys); listed for tools that call Supabase APIs from a client.
SUPABASE_ANON_KEY=
# Service-role/secret key. SERVER-SIDE ONLY. FireFinder does not need it:
# the API connects to Postgres directly via DATABASE_URL. Never put it in an
# MCP config, a browser, or any client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Node API server) ---------------------------------------------
# PostgreSQL with pgvector. For Supabase use the Session pooler (port 5432) or
# the Transaction pooler (port 6543; prepared statements are then disabled
# automatically). Default: pglite://.data/firefinder (zero-setup local dev).
DATABASE_URL=
DB_POOL_MAX=10
# auto | true | false
DB_PREPARE=auto
# Apply migrations on startup. Empty = true for pglite, false for postgres.
AUTO_MIGRATE=

# --- Security ------------------------------------------------------------------
# Secret used to derive anonymous voter hashes (one vote per install).
# Required for a shared database. Generate with: openssl rand -hex 32
FIREFINDER_VOTER_SECRET=
# Browser origins allowed to call the API (comma-separated). Empty = none.
CORS_ORIGINS=
# Trust X-Forwarded-For for per-IP rate limits (only behind your own proxy).
TRUST_PROXY=false
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=20

# --- Server ------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Serve the developer console at /
DEV_CONSOLE=true

# --- Remote MCP (claude.ai, Claude mobile, Claude Code) ----------------------
# Public base URL of this server: the OAuth issuer; the MCP endpoint is <url>/mcp.
# Default: http://localhost:$PORT. Must be the https:// URL users reach in production.
FIREFINDER_PUBLIC_URL=
# Signs OAuth access tokens and client ids. Default: FIREFINDER_VOTER_SECRET.
FIREFINDER_OAUTH_SECRET=
MCP_READ_PER_MINUTE=60
MCP_WRITE_PER_MINUTE=20
MCP_IDENTITIES_PER_IP_PER_HOUR=10
# Supabase Edge Function only (set with `supabase secrets set`): the database
# region; database-bound requests are forwarded there.
# FIREFINDER_DB_REGION=ap-southeast-1

# --- Embeddings (local, no external AI calls) --------------------------------
# gte-small runs in-process; the model (~34 MB) downloads once to this folder.
# q8 | fp16 | fp32
EMBEDDING_DTYPE=q8
EMBEDDING_CACHE_DIR=.cache/models

# --- Claude integration (MCP server) ------------------------------------------
# Where the MCP server finds the API, and the key it uses (read,write scopes).
FIREFINDER_API_URL=http://localhost:8787
# Hosted on Supabase: run the API in your database region (e.g. eu-central-1),
# so every database round trip stays local. Leave empty for local/Node servers.
FIREFINDER_API_REGION=
FIREFINDER_API_KEY=
# Optional admin key, used by `npm run smoke -- --write` to clean up.
FIREFINDER_ADMIN_KEY=
